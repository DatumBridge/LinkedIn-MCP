# LinkedIn MCP Configuration

PORT=8000
LOG_LEVEL=INFO

# OAuth client (alternative to credentials.json)
# LINKEDIN_OAUTH_CREDENTIALS=/app/credentials.json
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Default: openid profile email w_member_social
# LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social

# Optional LinkedIn-Version header (YYYYMM) for Rest.li endpoints that require it
# LINKEDIN_API_VERSION=202401

# Image upload size gate (bytes). Default 8388608 (8 MiB).
LINKEDIN_MAX_IMAGE_BYTES=8388608

# Post commentary length gate. Default 3000.
LINKEDIN_MAX_TEXT_CHARS=3000

# Outbound HTTP timeout (seconds). Default 30.
LINKEDIN_HTTP_TIMEOUT_SEC=30

# Local OAuth/test UI. Defaults to 0 (off). Set 1 for /test UI and OAuth connect.
# For k8s local testing, k8s/deployment.yaml ConfigMap currently enables it.
LINKEDIN_ENABLE_OAUTH_UI=0

# Path jail for credentials_path (defaults to project root)
# LINKEDIN_CREDENTIALS_DIR=/var/linkedin-credentials

# Local create throttle (per access-token fingerprint). 0 disables.
LINKEDIN_CREATE_RATE_LIMIT=10
LINKEDIN_CREATE_RATE_WINDOW_SEC=3600

# Optional Tool Registry (platform)
# TOOL_REGISTRY_BASE_URL=http://datumbridge-mcp:8081/api/v1
# TOOL_REGISTRY_API_KEY=
